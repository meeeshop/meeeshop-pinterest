# Pinterest Credentials (required)
PINTEREST_EMAIL=your_pinterest_email@gmail.com
PINTEREST_PASSWORD=your_pinterest_password

# Shopify Credentials (required)
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# Store Base URL for product links
STORE_BASE_URL=https://your-store.com

# AI API Keys (pick at least one for content generation)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# YouTube channel URL for Shorts discovery (no API key needed)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@your-channel

